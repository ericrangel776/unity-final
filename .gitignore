# --- Claude Code (append these lines to your .gitignore) ---
# Personal, machine-specific overrides: never commit
.claude/settings.local.json
CLAUDE.local.md
# Python bytecode (hooks and your own code)
__pycache__/
# Tool caches
.ruff_cache/
.pytest_cache/

# --- Unity (generated / machine-specific; regenerated on open) ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/TestResults/
# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta
# IDE / solution files Unity regenerates
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
# Crash reports and build artifacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
